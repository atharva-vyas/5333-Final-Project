server:
  host: 0.0.0.0
  port: 9091
log:
  level: info
jwt_secret: <GENERATE_WITH_openssl_rand_-hex_32>
default_redirection_url: https://app.example.com

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain:
        - "auth.example.com"
      policy: bypass
    - domain:
        - "example.com"
        - "*.example.com"
        - "app.example.com"
      policy: one_factor

session:
  name: authelia_session
  secret: <GENERATE_WITH_openssl_rand_-hex_32>
  expiration: 12h
  inactivity: 45m
  remember_me_duration: 1M
  domain: example.com

  redis:
    host: 172.20.0.50
    port: 6379

regulation:
  max_retries: 3
  find_time: 5m
  ban_time: 15m

storage:
  encryption_key: <GENERATE_WITH_openssl_rand_-hex_32>
  local:
    path: /config/db.sqlite3

notifier:
  filesystem:
    filename: /config/notification.txt
